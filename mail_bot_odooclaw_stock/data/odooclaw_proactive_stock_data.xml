<odoo>
    <!--
        noupdate="0": shipped defaults that must keep reaching existing
        installations. To customise, create a NEW mail.odooclaw.area row.

        The `is_storable` filter is NOT optional. In Odoo 18 a negative
        qty_available on a consumable or a service is meaningless, and the
        counter would drift from what the user can actually act on. Verified
        against a real Odoo 18 database with a storable product pushed negative
        through an inventory adjustment: the counter moves +1, and a storable
        product with no stock does not move it. Verified 2026-09.
    -->
    <data noupdate="0">
        <record id="area_inventory" model="mail.odooclaw.area">
            <field name="name">Inventory</field>
            <field name="area">inventory</field>
            <field name="sequence">40</field>
            <field name="enabled" eval="True" />
            <field name="model_name">product.product</field>
            <field name="signal_definition">{"negative_stock_products": {"model": "product.product", "domain": [["qty_available", "<", 0], ["is_storable", "=", true]]}}</field>
        </record>
    </data>
</odoo>
