<odoo>
    <record id="view_mail_odooclaw_audience_list" model="ir.ui.view">
        <field name="name">mail.odooclaw.audience.list</field>
        <field name="model">mail.odooclaw.audience</field>
        <field name="arch" type="xml">
            <list string="Audiences">
                <field name="name" />
                <field name="internal_only" />
                <field name="include_inactive" />
                <field name="group_ids" widget="many2many_tags" />
                <field name="excluded_group_ids" widget="many2many_tags" />
                <field name="active" invisible="1" />
            </list>
        </field>
    </record>

    <record id="view_mail_odooclaw_audience_form" model="ir.ui.view">
        <field name="name">mail.odooclaw.audience.form</field>
        <field name="model">mail.odooclaw.audience</field>
        <field name="arch" type="xml">
            <form string="Audience">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <group>
                        <group>
                            <field name="name" />
                            <field name="active" invisible="1" />
                            <field name="internal_only" />
                            <field name="include_inactive" />
                        </group>
                        <group>
                            <field
                                name="group_ids"
                                widget="many2many_tags"
                                options="{'no_create': True}"
                            />
                            <field
                                name="excluded_group_ids"
                                widget="many2many_tags"
                                options="{'no_create': True}"
                            />
                            <field
                                name="company_ids"
                                widget="many2many_tags"
                                options="{'no_create': True}"
                            />
                        </group>
                    </group>
                    <group>
                        <div class="text-muted">
                            Assistance is offered to <b>any internal user</b> (employee). Portal
                            users and the public user never receive it: they are not company
                            staff and the counters quoted in the offer are business
                            figures.
                        </div>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mail_odooclaw_audience" model="ir.actions.act_window">
        <field name="name">OdooClaw Proactive Audience</field>
        <field name="res_model">mail.odooclaw.audience</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define who is offered assistance</p>
            <p>
                Without a configured audience nobody is offered assistance: a missing
                configuration is never read as "everyone".
            </p>
        </field>
    </record>

    <menuitem
        id="menu_mail_odooclaw_audience"
        name="Audience"
        action="action_mail_odooclaw_audience"
        parent="base.menu_custom"
        sequence="90"
    />
</odoo>
