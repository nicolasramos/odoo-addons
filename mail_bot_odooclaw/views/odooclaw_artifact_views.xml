<odoo>
    <record id="view_odooclaw_artifact_list" model="ir.ui.view">
        <field name="name">odooclaw.artifact.list</field>
        <field name="model">odooclaw.artifact</field>
        <field name="arch" type="xml">
            <list string="Artifacts">
                <field name="name" />
                <field name="artifact_type" />
                <field name="user_id" widget="many2one_avatar_user" />
                <field name="tag_list" optional="show" />
                <field name="create_date" />
                <field name="active" invisible="1" />
            </tree>
        </field>
    </record>

    <record id="view_odooclaw_artifact_form" model="ir.ui.view">
        <field name="name">odooclaw.artifact.form</field>
        <field name="model">odooclaw.artifact</field>
        <field name="arch" type="xml">
            <form string="Artifact">
                <widget
                    name="web_ribbon"
                    title="Archived"
                    bg_color="bg-danger"
                    invisible="active"
                />
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="artifact_type" />
                            <field name="tag_list" />
                            <field name="active" invisible="1" />
                        </group>
                        <group>
                            <field name="user_id" />
                            <field name="channel_id" />
                            <field name="message_id" />
                        </group>
                    </group>
                    <field name="content" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_odooclaw_artifact_search" model="ir.ui.view">
        <field name="name">odooclaw.artifact.search</field>
        <field name="model">odooclaw.artifact</field>
        <field name="arch" type="xml">
            <search string="Artifacts">
                <field name="name" />
                <field name="plain_text" />
                <field name="tag_list" />
                <filter
                    string="Documents"
                    name="document"
                    domain="[('artifact_type', '=', 'document')]"
                />
                <filter
                    string="Tables"
                    name="table"
                    domain="[('artifact_type', '=', 'table')]"
                />
                <filter
                    string="Code"
                    name="code"
                    domain="[('artifact_type', '=', 'code')]"
                />
                <separator />
                <filter string="My artifacts" name="mine" domain="[('user_id', '=', uid)]" />
                <filter string="Archived" name="archived" domain="[('active', '=', False)]" />
                <group expand="0" string="Group by">
                    <filter string="Type" name="group_type" context="{'group_by': 'artifact_type'}" />
                    <filter string="Owner" name="group_user" context="{'group_by': 'user_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_odooclaw_artifact" model="ir.actions.act_window">
        <field name="name">Artifacts</field>
        <field name="res_model">odooclaw.artifact</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_odooclaw_artifact_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing saved yet</p>
            <p>
                When the assistant builds something in a chat (a summary, a table,
                a snippet), ask it to keep it. It lands here: named, owned by you
                and searchable.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_odooclaw_artifact"
        name="Artifacts"
        action="action_odooclaw_artifact"
        parent="mail.menu_root_discuss"
        sequence="60"
    />
</odoo>
