<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.odooclaw</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='users_setting_container']" position="after">
                <block title="OdooClaw" name="odooclaw_settings">
                    <setting
                        id="odooclaw_pipeline_enabled_setting"
                        help="When a customer writes on a record of an area with a pipeline, the bot processes it according to that pipeline."
                    >
                        <field name="odooclaw_pipeline_enabled" />
                    </setting>
                    <setting
                        id="odooclaw_pipeline_escalate_user_setting"
                        help="Person who receives the work the bot cannot finish: no answer, an ambiguous request, or the customer asking for a human."
                    >
                        <field name="odooclaw_pipeline_escalate_user_id" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
