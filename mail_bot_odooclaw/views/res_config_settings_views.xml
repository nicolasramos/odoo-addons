<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.odooclaw</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='users_setting_container']" position="after">
                <div class="row mt16 o_settings_container" name="odooclaw_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="odooclaw_pipeline_enabled" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="odooclaw_pipeline_enabled" />
                            <div class="text-muted">
                                When a customer writes on a record of an area with a pipeline,
                                the bot processes it according to that pipeline.
                            </div>
                            <div class="content-group mt16" invisible="not odooclaw_pipeline_enabled">
                                <label for="odooclaw_pipeline_escalate_user_id" class="o_form_label" />
                                <div>
                                    <field name="odooclaw_pipeline_escalate_user_id" />
                                </div>
                                <div class="text-muted">
                                    Person who receives the work the bot cannot finish: no answer,
                                    an ambiguous request, or the customer asking for a human.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
