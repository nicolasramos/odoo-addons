<odoo>
    <!--
        noupdate="0": shipped defaults that must keep reaching existing
        installations. To customise, create a NEW mail.odooclaw.area row: the
        resolver prefers the most specific match and an upgrade restores this
        one.

        Verified against a real Odoo 18 database: a draft purchase order moves
        the counter and a confirmed one leaves it unchanged. Verified 2026-09.
    -->
    <data noupdate="0">
        <record id="area_compras" model="mail.odooclaw.area">
            <field name="name">Purchase</field>
            <field name="area">compras</field>
            <field name="sequence">30</field>
            <field name="enabled" eval="True" />
            <field name="model_name">purchase.order</field>
            <field
                name="signal_definition"
            >{"draft_purchase_orders": {"model": "purchase.order", "domain": [["state", "=", "draft"]]}}</field>
        </record>
    </data>
</odoo>
