<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_dynamic_rule_view_tree" model="ir.ui.view">
        <field name="name">account.dynamic.rule.list</field>
        <field name="model">account.dynamic.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="payment_mode_id"/>
                <field name="description_match"/>
                <field name="account_id"/>
                <field name="analytic_account_id"/>
                <field name="target_product_id"/>
                <field name="payment_term_id"/>
                <field name="tax_ids" widget="many2many_tags"/>
                <field name="fiscal_position_id"/>
            </list>
        </field>
    </record>

    <record id="account_dynamic_rule_view_form" model="ir.ui.view">
        <field name="name">account.dynamic.rule.form</field>
        <field name="model">account.dynamic.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Rule Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <group string="Conditions">
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="payment_mode_id"/>
                            <field name="description_match"/>
                        </group>
                        <group string="Actions">
                            <field name="account_id"/>
                            <field name="analytic_account_id"/>
                            <field name="payment_term_id"/>
                            <field name="tax_ids" widget="many2many_tags"/>
                            <field name="fiscal_position_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Help &amp; Tips">
                            <div class="alert alert-info" role="alert" style="margin-bottom:0px;">
                                <h3>How to use Dynamic Rules</h3>
                                <p>Rules are evaluated by <b>Sequence</b> (Low to High). The first matching rule is applied.</p>
                                
                                <hr/>
                                
                                <h4>🧩 Wildcards (Empty Fields)</h4>
                                <ul>
                                    <li><b>Partner empty:</b> Matches ANY Partner.</li>
                                    <li><b>Product empty:</b> Matches ANY Product.</li>
                                </ul>
                                
                                <h4>🔍 Description Match</h4>
                                <p>If you set text in <i>Description Match</i>, the rule will only apply if the invoice line description <b>contains</b> that text (Case Insensitive).</p>
                                
                                <h4>📊 Example Scenarios</h4>
                                <ul>
                                    <li><b>Global Service:</b> Partner=(Empty), Description="Hosting" ➡ Assign Analytic Account "IT".</li>
                                    <li><b>Specific Vendor:</b> Partner="Amazon", Product=(Empty) ➡ Assign Account "629.02 (Software)".</li>
                                </ul>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_dynamic_rule" model="ir.actions.act_window">
        <field name="name">Account Dynamic Rules</field>
        <field name="res_model">account.dynamic.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_account_dynamic_rule"
              parent="account.account_account_menu"
              action="action_account_dynamic_rule"
              sequence="100"/>
</odoo>
