<odoo>
    <data noupdate="0">
        <record id="area_sales" model="mail.odooclaw.area">
            <field name="name">Sales</field>
            <field name="area">sales</field>
            <field name="sequence">20</field>
            <field name="enabled" eval="True" />
            <field name="model_name">sale.order</field>
            <field name="signal_definition">{"draft_quotations": {"model": "sale.order", "domain": [["state", "=", "draft"]]}, "stale_opportunities": {"model": "sale.order", "domain": [["state", "=", "draft"], ["date_order", "&lt;", "$today_minus_30_days"]]}}</field>
        </record>
    </data>
</odoo>