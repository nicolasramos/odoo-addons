<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_agent_stale_executions" model="ir.cron">
            <field name="name">AI Agent: fail stale executions</field>
            <field name="model_id" ref="model_odoo_agent_execution"/>
            <field name="state">code</field>
            <field name="code">model._cron_mark_stale()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
