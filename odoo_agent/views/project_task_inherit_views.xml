<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_task_form_inherit_agent" model="ir.ui.view">
        <field name="name">project.task.form.inherit.agent</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <field name="user_ids" position="after">
                <field name="agent_id" options="{'no_create': True}" placeholder="Assign to AI agent..."/>
                <field name="latest_execution_status" widget="badge" readonly="1"/>
                <field name="latest_execution_id" readonly="1"/>
            </field>
            <div name="button_box" position="inside">
                <button name="action_view_agent_executions" type="object" class="oe_stat_button" icon="play_circle" icon_class="oi-filled">
                    <field name="execution_count" widget="statinfo" string="Executions"/>
                </button>
                <button name="action_view_agent_communications" type="object" class="oe_stat_button" icon="forum" icon_class="oi-filled">
                    <field name="agent_chat_message_count" widget="statinfo" string="Agent Messages"/>
                </button>
                <button name="action_view_agent_logs" type="object" class="oe_stat_button" icon="list_alt" string="Agent Logs" invisible="not latest_execution_id"/>
            </div>
            <xpath expr="//header" position="inside">
                <button name="action_send_to_agent" type="object" string="Send to Agent" class="btn-primary" invisible="not agent_id"/>
                <button name="action_retry_agent_execution" type="object" string="Retry Agent" invisible="not latest_execution_id"/>
                <button name="action_cancel_agent_execution" type="object" string="Cancel Agent" invisible="latest_execution_status not in ('queued', 'running', 'waiting_input', 'cancel_requested')"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Agent Communications" name="agent_communications">
                    <div class="o_agent_comms">
                        <div class="o_agent_comms_header">
                            <div>
                                <div class="o_agent_comms_eyebrow">Task conversation</div>
                                <h3>Talk with agents without leaving the task</h3>
                                <p>
                                    Send follow-up instructions, receive agent replies, and keep every message linked to
                                    a traceable execution, logs, status, and final result.
                                </p>
                            </div>
                            <div class="o_agent_comms_status" invisible="not latest_execution_status">
                                <span>Latest status</span>
                                <field name="latest_execution_status" widget="badge" readonly="1"/>
                            </div>
                        </div>

                        <div class="o_agent_comms_thread">
                            <field name="agent_chat_message_ids" nolabel="1" readonly="1" mode="kanban" class="o_agent_comms_messages">
                                <kanban class="o_agent_comms_kanban" create="0" edit="0" delete="0" default_order="timestamp asc, id asc">
                                    <field name="timestamp"/>
                                    <field name="author_type"/>
                                    <field name="author_id"/>
                                    <field name="agent_id"/>
                                    <field name="content"/>
                                    <field name="delivery_state"/>
                                    <field name="execution_id"/>
                                    <templates>
                                        <t t-name="card">
                                            <div t-att-class="'o_agent_message ' + (record.author_type.raw_value == 'agent' ? 'o_agent_message_agent' : 'o_agent_message_user')">
                                                <div class="o_agent_message_avatar">
                                                    <i t-if="record.author_type.raw_value == 'agent'" class="oi" data-icon="wand_stars" title="Agent"/>
                                                    <i t-else="" class="oi oi-filled" data-icon="person" title="User"/>
                                                </div>
                                                <div class="o_agent_message_body">
                                                    <div class="o_agent_message_meta">
                                                        <div class="o_agent_message_author">
                                                            <t t-if="record.author_type.raw_value == 'agent'">
                                                                <field name="agent_id"/>
                                                                <span class="o_agent_message_role">Agent</span>
                                                            </t>
                                                            <t t-else="">
                                                                <field name="author_id"/>
                                                                <span class="o_agent_message_role">User</span>
                                                            </t>
                                                        </div>
                                                        <div class="o_agent_message_context">
                                                            <field name="timestamp"/>
                                                            <span t-att-class="'o_agent_message_delivery o_agent_message_delivery_' + record.delivery_state.raw_value">
                                                                <field name="delivery_state"/>
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <div class="o_agent_message_content">
                                                        <field name="content"/>
                                                    </div>
                                                    <div class="o_agent_message_execution" t-if="record.execution_id.raw_value">
                                                        <i class="oi" data-icon="flash_on" title="Execution"/>
                                                        <field name="execution_id"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </div>

                        <div class="o_agent_comms_composer">
                            <div class="o_agent_comms_target">
                                <label for="agent_chat_composer_agent_id">Agent</label>
                                <field name="agent_chat_composer_agent_id"
                                       options="{'no_create': True}"
                                       placeholder="Use assigned agent"/>
                            </div>
                            <div class="o_agent_comms_input">
                                <field name="agent_chat_composer_body"
                                       nolabel="1"
                                       placeholder="Write a reply or follow-up for the agent..."/>
                            </div>
                            <button name="action_send_agent_chat_message"
                                    type="object"
                                    string="Send"
                                    icon="send" icon_class="oi-filled"
                                    class="btn-primary o_agent_comms_send"/>
                        </div>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_project_task_search_inherit_agent" model="ir.ui.view">
        <field name="name">project.task.search.inherit.agent</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <filter name="my_tasks" position="after">
                <separator/>
                <filter name="ai_assigned" string="Agent Assigned" domain="[('agent_id', '!=', False)]"/>
                <filter name="ai_working" string="Agent Working" domain="[('latest_execution_status', 'in', ['queued', 'running', 'waiting_input', 'cancel_requested'])]"/>
                <filter name="ai_failed" string="Agent Failed" domain="[('latest_execution_status', '=', 'failed')]"/>
                <filter name="ai_done" string="Agent Done" domain="[('latest_execution_status', '=', 'completed')]"/>
                <group>
                    <filter name="group_agent" string="Agent" context="{'group_by': 'agent_id'}"/>
                    <filter name="group_agent_status" string="Agent Status" context="{'group_by': 'latest_execution_status'}"/>
                </group>
            </filter>
        </field>
    </record>


    <record id="view_project_task_kanban_inherit_agent" model="ir.ui.view">
        <field name="name">project.task.card.inherit.agent</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_card"/>
        <field name="arch" type="xml">
            <xpath expr="//card/field[@name='state']" position="after">
                <field name="agent_id"/>
                <field name="latest_execution_status"/>
                <field name="latest_execution_id"/>
                <field name="execution_count"/>
                <field name="agent_chat_message_count"/>
            </xpath>
            <xpath expr="//t[@t-name='card']//field[@name='name']" position="after">
                <div t-if="record.agent_id.raw_value" class="d-flex align-items-center justify-content-between gap-1 mt-1 mb-1">
                    <span class="badge rounded-pill text-bg-light border text-truncate" title="Assigned agent">
                        <i class="oi me-1" data-icon="wand_stars" aria-label="Agent"/>
                        <field name="agent_id"/>
                    </span>
                    <span t-if="['queued', 'running', 'waiting_input', 'cancel_requested'].includes(record.latest_execution_status.raw_value)"
                          class="badge rounded-pill text-bg-primary" title="Agent is working on this task">
                        <i class="oi oi-filled me-1" data-icon="play_circle" aria-label="Working"/>
                        Working
                    </span>
                    <span t-elif="record.latest_execution_status.raw_value == 'failed'"
                          class="badge rounded-pill text-bg-danger" title="Latest agent execution failed">
                        <i class="oi me-1" data-icon="warning" aria-label="Failed"/>
                        Failed
                    </span>
                    <span t-elif="record.latest_execution_status.raw_value == 'completed'"
                          class="badge rounded-pill text-bg-success" title="Latest agent execution completed">
                        <i class="oi me-1" data-icon="check" aria-label="Done"/>
                        Done
                    </span>
                </div>
            </xpath>
            <xpath expr="//t[@t-name='card']//footer/field[@name='activity_ids']" position="after">
                <span t-if="record.execution_count.raw_value" class="badge rounded-pill text-bg-secondary" title="Agent executions">
                    <i class="oi me-1" data-icon="flash_on" aria-label="Executions"/>
                    <field name="execution_count"/>
                </span>
                <span t-if="record.agent_chat_message_count.raw_value" class="badge rounded-pill text-bg-light border" title="Agent messages">
                    <i class="oi oi-filled me-1" data-icon="forum" aria-label="Agent messages"/>
                    <field name="agent_chat_message_count"/>
                </span>
            </xpath>
        </field>
    </record>

</odoo>
