<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agent_runtime_tree" model="ir.ui.view">
        <field name="name">odoo.agent.runtime.tree</field>
        <field name="model">odoo.agent.runtime</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'online'" decoration-warning="status == 'busy'" decoration-muted="status == 'offline'">
                <field name="name"/>
                <field name="machine_id"/>
                <field name="status" widget="badge"/>
                <field name="last_seen"/>
                <field name="active_agent_count"/>
                <field name="queued_execution_count"/>
                <field name="running_execution_count"/>
            </list>
        </field>
    </record>

    <record id="view_agent_runtime_form" model="ir.ui.view">
        <field name="name">odoo.agent.runtime.form</field>
        <field name="model">odoo.agent.runtime</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_api_key" type="object" string="Generate API Key" groups="odoo_agent.group_agent_admin"/>
                    <button name="action_mark_online" type="object" string="Mark Online"/>
                    <button name="action_mark_offline" type="object" string="Mark Offline"/>
                    <field name="status" widget="statusbar" statusbar_visible="offline,online,busy"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>Runtime tip:</strong>
                        A runtime is the machine process that polls Odoo, starts executions,
                        streams logs, and reports completion. Keep API keys scoped and rotate them when a host changes owner.
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_executions" type="object" class="oe_stat_button" icon="play_circle" icon_class="oi-filled">
                            <field name="running_execution_count" widget="statinfo" string="Running"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="machine_id"/>
                            <field name="ip_address"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="last_seen" readonly="1"/>
                            <field name="version"/>
                            <field name="device_info"/>
                            <field name="api_key" password="True" groups="odoo_agent.group_agent_admin"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="agents" string="Agents">
                            <div class="alert alert-light" role="alert">
                                Agents assigned here share this runtime's installed CLIs, MCP connectivity, and local permissions.
                            </div>
                            <field name="agent_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="status" widget="badge"/>
                                    <field name="engine"/>
                                </list>
                            </field>
                        </page>
                        <page name="executions" string="Executions">
                            <div class="alert alert-light" role="alert">
                                Use this tab to see what this runtime is currently running or has recently completed.
                            </div>
                            <field name="execution_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="status" widget="badge"/>
                                    <field name="agent_id"/>
                                    <field name="task_id"/>
                                </list>
                            </field>
                        </page>
                        <page name="capabilities" string="Capabilities">
                            <div class="alert alert-light" role="alert">
                                Capabilities are reported by the runtime: supported engines, installed CLIs,
                                MCP support, OS details, and capacity. Use them to avoid assigning work to the wrong machine.
                            </div>
                            <field name="capabilities" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_agent_runtime_search" model="ir.ui.view">
        <field name="name">odoo.agent.runtime.search</field>
        <field name="model">odoo.agent.runtime</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="machine_id"/>
                <filter name="online" string="Online" domain="[('status', '=', 'online')]"/>
                <filter name="offline" string="Offline" domain="[('status', '=', 'offline')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
