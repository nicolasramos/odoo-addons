<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_agent_dashboard" model="ir.actions.act_window">
        <field name="name">Agent Operations</field>
        <field name="res_model">odoo.agent.execution</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', 'in', ['queued', 'running', 'waiting_input', 'failed', 'cancel_requested'])]</field>
        <field name="help" type="html"><p>Monitor active and failed agent executions.</p></field>
    </record>

    <record id="action_agent_runtime" model="ir.actions.act_window">
        <field name="name">Runtimes</field>
        <field name="res_model">odoo.agent.runtime</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_agent" model="ir.actions.act_window">
        <field name="name">Agents</field>
        <field name="res_model">odoo.agent</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_agent_execution" model="ir.actions.act_window">
        <field name="name">Executions</field>
        <field name="res_model">odoo.agent.execution</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_agent_execution_failed" model="ir.actions.act_window">
        <field name="name">Failed Executions</field>
        <field name="res_model">odoo.agent.execution</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', '=', 'failed')]</field>
    </record>

    <record id="action_agent_skill" model="ir.actions.act_window">
        <field name="name">Skills</field>
        <field name="res_model">odoo.agent.skill</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_agent_mcp_server" model="ir.actions.act_window">
        <field name="name">MCP Servers</field>
        <field name="res_model">odoo.agent.mcp.server</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_agent_task" model="ir.actions.act_window">
        <field name="name">Legacy Tasks</field>
        <field name="res_model">odoo.agent.task</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_agent_log" model="ir.actions.act_window">
        <field name="name">Execution Logs</field>
        <field name="res_model">odoo.agent.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_agent_chat_message" model="ir.actions.act_window">
        <field name="name">Agent Chats</field>
        <field name="res_model">odoo.agent.chat.message</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_agent_stage_map" model="ir.actions.act_window">
        <field name="name">Stage Mapping</field>
        <field name="res_model">odoo.agent.stage.map</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_agent_stage_trigger" model="ir.actions.act_window">
        <field name="name">Stages That Dispatch Agents</field>
        <field name="res_model">project.task.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No project stages yet
            </p>
            <p>
                Mark a stage as dispatching and every task entering it will queue
                an execution for its assigned agent.
            </p>
        </field>
    </record>
</odoo>
