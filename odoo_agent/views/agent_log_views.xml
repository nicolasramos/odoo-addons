<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agent_log_tree" model="ir.ui.view">
        <field name="name">odoo.agent.log.tree</field>
        <field name="model">odoo.agent.log</field>
        <field name="arch" type="xml">
            <list decoration-danger="level == 'error'" decoration-warning="level == 'warn'" decoration-muted="level == 'debug'">
                <field name="timestamp"/>
                <field name="level" widget="badge"/>
                <field name="execution_id"/>
                <field name="agent_id"/>
                <field name="runtime_id"/>
                <field name="message"/>
                <field name="command"/>
                <field name="exit_code"/>
            </list>
        </field>
    </record>

    <record id="view_agent_log_form" model="ir.ui.view">
        <field name="name">odoo.agent.log.form</field>
        <field name="model">odoo.agent.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="execution_id"/>
                            <field name="agent_id" readonly="1"/>
                            <field name="runtime_id" readonly="1"/>
                            <field name="timestamp"/>
                        </group>
                        <group>
                            <field name="level"/>
                            <field name="exit_code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1"/>
                    </group>
                    <group string="Command">
                        <field name="command" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_agent_log_search" model="ir.ui.view">
        <field name="name">odoo.agent.log.search</field>
        <field name="model">odoo.agent.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="message"/>
                <field name="execution_id"/>
                <field name="agent_id"/>
                <field name="runtime_id"/>
                <filter name="errors" string="Errors" domain="[('level', '=', 'error')]"/>
                <filter name="warnings" string="Warnings" domain="[('level', '=', 'warn')]"/>
                <group>
                    <filter name="group_level" string="Level" context="{'group_by': 'level'}"/>
                    <filter name="group_execution" string="Execution" context="{'group_by': 'execution_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
