<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agent_stage_map_tree" model="ir.ui.view">
        <field name="name">odoo.agent.stage.map.tree</field>
        <field name="model">odoo.agent.stage.map</field>
        <field name="arch" type="xml">
            <list>
                <field name="project_id"/>
                <field name="agent_status"/>
                <field name="stage_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_agent_stage_map_form" model="ir.ui.view">
        <field name="name">odoo.agent.stage.map.form</field>
        <field name="model">odoo.agent.stage.map</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="agent_status"/>
                            <field name="project_id"
                                options="{'no_create': True}"/>
                            <field name="stage_id"
                                domain="[('fold', '=', False)]"
                                options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="display_name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_agent_stage_map_search" model="ir.ui.view">
        <field name="name">odoo.agent.stage.map.search</field>
        <field name="model">odoo.agent.stage.map</field>
        <field name="arch" type="xml">
            <search>
                <field name="agent_status"/>
                <field name="stage_id"/>
                <field name="project_id"/>
                <separator/>
                <filter name="global_scope" string="All projects"
                        domain="[('project_id', '=', False)]"/>
                <filter name="project_scope" string="Project specific"
                        domain="[('project_id', '!=', False)]"/>
            </search>
        </field>
    </record>
</odoo>
