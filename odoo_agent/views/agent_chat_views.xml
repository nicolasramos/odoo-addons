<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agent_chat_message_tree" model="ir.ui.view">
        <field name="name">odoo.agent.chat.message.tree</field>
        <field name="model">odoo.agent.chat.message</field>
        <field name="arch" type="xml">
            <list decoration-muted="is_read" decoration-info="author_type == 'agent'">
                <field name="timestamp"/>
                <field name="agent_id"/>
                <field name="author_type" widget="badge"/>
                <field name="author_id"/>
                <field name="project_task_id"/>
                <field name="execution_id"/>
                <field name="delivery_state" widget="badge"/>
                <field name="content"/>
                <field name="is_read"/>
            </list>
        </field>
    </record>

    <record id="view_agent_chat_message_form" model="ir.ui.view">
        <field name="name">odoo.agent.chat.message.form</field>
        <field name="model">odoo.agent.chat.message</field>
        <field name="arch" type="xml">
            <form string="Agent Chat Message">
                <header>
                    <button name="mark_as_read" type="object" string="Mark as Read"
                        invisible="is_read"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="agent_id"/>
                            <field name="author_type" widget="badge"/>
                            <field name="author_id"/>
                            <field name="delivery_state" widget="badge"/>
                        </group>
                        <group>
                            <field name="project_task_id"/>
                            <field name="execution_id"/>
                            <field name="timestamp"/>
                            <field name="is_read"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="content" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_agent_chat_message_search" model="ir.ui.view">
        <field name="name">odoo.agent.chat.message.search</field>
        <field name="model">odoo.agent.chat.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="agent_id"/>
                <field name="author_id"/>
                <field name="project_task_id"/>
                <field name="execution_id"/>
                <field name="content"/>
                <filter name="unread" string="Unread" domain="[('is_read', '=', False)]"/>
                <filter name="from_user" string="From Users" domain="[('author_type', '=', 'user')]"/>
                <filter name="from_agent" string="From Agents" domain="[('author_type', '=', 'agent')]"/>
                <filter name="queued" string="Queued" domain="[('delivery_state', '=', 'queued')]"/>
                <group>
                    <filter name="group_agent" string="Agent" context="{'group_by': 'agent_id'}"/>
                    <filter name="group_task" string="Project Task" context="{'group_by': 'project_task_id'}"/>
                    <filter name="group_execution" string="Execution" context="{'group_by': 'execution_id'}"/>
                    <filter name="group_state" string="Delivery State" context="{'group_by': 'delivery_state'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
