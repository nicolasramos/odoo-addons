<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agent_skill_tree" model="ir.ui.view">
        <field name="name">odoo.agent.skill.tree</field>
        <field name="model">odoo.agent.skill</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category" widget="badge"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_agent_skill_form" model="ir.ui.view">
        <field name="name">odoo.agent.skill.form</field>
        <field name="model">odoo.agent.skill</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>Skill tip:</strong>
                        A skill should describe one concrete reusable capability, not a whole agent personality.
                        Keep it short, testable, and specific so the runtime can compose several skills safely.
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                    <group string="Instructions">
                        <div class="alert alert-light" role="alert">
                            Explain when to use this skill, required inputs, expected output, and guardrails.
                            These instructions are injected into the agent prompt at execution time.
                        </div>
                        <field name="instructions" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_agent_skill_search" model="ir.ui.view">
        <field name="name">odoo.agent.skill.search</field>
        <field name="model">odoo.agent.skill</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category"/>
                <group>
                    <filter name="group_category" string="Category"
                        context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
