<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agent_execution_list" model="ir.ui.view">
        <field name="name">odoo.agent.execution.list</field>
        <field name="model">odoo.agent.execution</field>
        <field name="arch" type="xml">
            <list decoration-info="status == 'queued'" decoration-warning="status in ('running', 'waiting_input', 'cancel_requested')" decoration-danger="status == 'failed'" decoration-success="status == 'completed'">
                <field name="name"/>
                <field name="status" widget="badge"/>
                <field name="agent_id"/>
                <field name="runtime_id"/>
                <field name="source"/>
                <field name="task_id"/>
                <field name="target_display_name"/>
                <field name="res_model"/>
                <field name="attempt"/>
                <field name="started_at"/>
                <field name="completed_at"/>
                <field name="log_count"/>
            </list>
        </field>
    </record>

    <record id="view_agent_execution_form" model="ir.ui.view">
        <field name="name">odoo.agent.execution.form</field>
        <field name="model">odoo.agent.execution</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="status != 'queued'"/>
                    <button name="action_complete" type="object" string="Complete" invisible="status != 'running'"/>
                    <button name="action_fail" type="object" string="Fail" invisible="status not in ('queued', 'running', 'waiting_input')"/>
                    <button name="action_request_cancel" type="object" string="Cancel" invisible="status in ('completed', 'failed', 'cancelled')"/>
                    <button name="action_retry" type="object" string="Retry" invisible="status not in ('failed', 'cancelled', 'completed')"/>
                    <field name="status" widget="statusbar" statusbar_visible="queued,running,waiting_input,completed,failed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_logs" type="object" class="oe_stat_button" icon="fa-list-alt">
                            <field name="log_count" widget="statinfo" string="Logs"/>
                        </button>
                        <button name="action_view_child_executions" type="object" class="oe_stat_button" icon="fa-sitemap" invisible="not child_execution_count">
                            <field name="child_execution_count" widget="statinfo" string="Delegated"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="agent_id"/>
                            <field name="runtime_id"/>
                            <field name="source"/>
                            <field name="chat_message_id" readonly="1"/>
                            <field name="requested_by_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="project_id"/>
                            <field name="task_id"/>
                            <field name="res_model" readonly="1"/>
                            <field name="res_id" readonly="1"/>
                            <field name="target_display_name" readonly="1"/>
                            <field name="parent_id"/>
                            <field name="mentioned_agent_ids" widget="many2many_tags" readonly="1"/>
                            <field name="attempt" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="timeout_seconds"/>
                            <field name="retry_limit"/>
                            <field name="started_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="completed_at" readonly="1"/>
                            <field name="last_heartbeat_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="prompt" string="Prompt">
                            <field name="prompt" nolabel="1"/>
                        </page>
                        <page name="logs" string="Logs">
                            <field name="log_ids" nolabel="1">
                                <list>
                                    <field name="timestamp"/>
                                    <field name="level" widget="badge"/>
                                    <field name="message"/>
                                    <field name="command"/>
                                    <field name="exit_code"/>
                                </list>
                            </field>
                        </page>
                        <page name="chat" string="Chat" invisible="source != 'chat'">
                            <div class="alert alert-light" role="alert">
                                Chat executions keep the user request, runtime work, and agent replies traceable.
                                Live notifications are published on the Odoo bus for this execution and agent.
                            </div>
                            <field name="chat_message_ids" nolabel="1" readonly="1">
                                <list decoration-info="author_type == 'agent'">
                                    <field name="timestamp"/>
                                    <field name="author_type" widget="badge"/>
                                    <field name="author_id"/>
                                    <field name="delivery_state" widget="badge"/>
                                    <field name="content"/>
                                </list>
                            </field>
                        </page>
                        <page name="delegations" string="Delegations">
                            <div class="alert alert-light" role="alert">
                                Mention agents in the prompt with @handle to create child executions.
                                Delegations are traceable through Parent Execution and this list.
                            </div>
                            <field name="child_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="status" widget="badge"/>
                                    <field name="agent_id"/>
                                    <field name="runtime_id"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                        <page name="result" string="Result">
                            <field name="result" nolabel="1"/>
                        </page>
                        <page name="error" string="Error">
                            <field name="error_message" nolabel="1"/>
                            <field name="cancellation_reason" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_agent_execution_search" model="ir.ui.view">
        <field name="name">odoo.agent.execution.search</field>
        <field name="model">odoo.agent.execution</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="agent_id"/>
                <field name="runtime_id"/>
                <field name="task_id"/>
                <field name="source"/>
                <filter name="queued" string="Queued" domain="[('status', '=', 'queued')]"/>
                <filter name="running" string="Running" domain="[('status', '=', 'running')]"/>
                <filter name="waiting_input" string="Waiting for Input" domain="[('status', '=', 'waiting_input')]"/>
                <filter name="failed" string="Failed" domain="[('status', '=', 'failed')]"/>
                <filter name="chat" string="Chat" domain="[('source', '=', 'chat')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_source" string="Source" context="{'group_by': 'source'}"/>
                    <filter name="group_agent" string="Agent" context="{'group_by': 'agent_id'}"/>
                    <filter name="group_runtime" string="Runtime" context="{'group_by': 'runtime_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
