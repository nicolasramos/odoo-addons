<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agent_task_tree" model="ir.ui.view">
        <field name="name">odoo.agent.task.tree</field>
        <field name="model">odoo.agent.task</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="agent_id"/>
                <field name="status" widget="badge"/>
                <field name="started_at"/>
                <field name="completed_at"/>
                <field name="log_count"/>
            </list>
        </field>
    </record>

    <record id="view_agent_task_form" model="ir.ui.view">
        <field name="name">odoo.agent.task.form</field>
        <field name="model">odoo.agent.task</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="badge"
                        />
                    <button name="action_start" type="object" string="Start"
                        class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_agent_log)d" type="action"
                            class="oe_stat_button" icon="list_alt">
                            <div class="o_stat_info">
                                <field name="log_count"/>
                                <span class="o_stat_text">Logs</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="agent_id"/>
                            <field name="project_id"/>
                            <field name="task_id"/>
                        </group>
                        <group>
                            <field name="status" widget="badge"/>
                            <field name="started_at"/>
                            <field name="completed_at"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" widget="html"/>
                    </group>
                    <notebook>
                        <page name="logs" string="Execution Logs">
                            <field name="log_ids" nolabel="1">
                                <list>
                                    <field name="timestamp"/>
                                    <field name="level" widget="badge"
                                        decoration-danger="level == 'error'"
                                        decoration-warning="level == 'warn'"
                                        decoration-info="level == 'info'"
                                        decoration-muted="level == 'debug'"/>
                                    <field name="message"/>
                                    <field name="command"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group string="Result" groups="odoo_agent.group_agent_admin">
                        <field name="result" nolabel="1"/>
                    </group>
                    <group string="Error" groups="odoo_agent.group_agent_admin">
                        <field name="error_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_agent_task_search" model="ir.ui.view">
        <field name="name">odoo.agent.task.search</field>
        <field name="model">odoo.agent.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="agent_id"/>
                <filter name="pending" string="Pending"
                    domain="[('status', '=', 'pending')]"/>
                <filter name="in_progress" string="In Progress"
                    domain="[('status', '=', 'in_progress')]"/>
                <filter name="completed" string="Completed"
                    domain="[('status', '=', 'completed')]"/>
                <group>
                    <filter name="group_status" string="Status"
                        context="{'group_by': 'status'}"/>
                    <filter name="group_agent" string="Agent"
                        context="{'group_by': 'agent_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
