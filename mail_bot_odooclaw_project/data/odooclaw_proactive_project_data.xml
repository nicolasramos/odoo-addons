<odoo>
    <data noupdate="0">
        <record id="area_projects" model="mail.odooclaw.area">
            <field name="name">Projects</field>
            <field name="area">projects</field>
            <field name="sequence">40</field>
            <field name="enabled" eval="True" />
            <field name="model_name">project.project</field>
            <field name="signal_definition">{"open_projects": {"model": "project.project", "domain": [["stage_id.fold", "=", false]]}}</field>
        </record>
        <record id="area_projects_overdue" model="mail.odooclaw.area">
            <field name="name">Projects - Overdue</field>
            <field name="area">projects</field>
            <field name="sequence">40</field>
            <field name="enabled" eval="True" />
            <field name="model_name">project.project</field>
            <field name="signal_definition">{"overdue_projects": {"model": "project.project", "domain": [["date_end", "&lt;", "$today"], ["stage_id.fold", "=", false]]}}</field>
        </record>
        <record id="area_tasks" model="mail.odooclaw.area">
            <field name="name">Projects - Tasks</field>
            <field name="area">projects</field>
            <field name="sequence">40</field>
            <field name="enabled" eval="True" />
            <field name="model_name">project.task</field>
            <field name="signal_definition">{"overdue_tasks": {"model": "project.task", "domain": [["date_end", "&lt;", "$today"], ["stage_id.fold", "=", false]]}, "waiting_tasks": {"model": "project.task", "domain": [["state", "=", "04_waiting_normal"]]}, "urgent_tasks": {"model": "project.task", "domain": [["priority", "=", "1"], ["stage_id.fold", "=", false]]}}</field>
        </record>
    </data>
</odoo>